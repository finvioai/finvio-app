# ============================================================
# SUPABASE
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # Server-side only — NEVER expose to frontend

# ============================================================
# ENCRYPTION
# ============================================================
ENCRYPTION_KEY=                    # 64-char hex string (32 bytes)
                                   # Generate with: openssl rand -hex 32

# ============================================================
# STRIPE
# ============================================================
STRIPE_SECRET_KEY=                 # sk_test_... for dev, sk_live_... for prod
STRIPE_WEBHOOK_SECRET=             # whsec_... from Stripe dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============================================================
# PLAID
# ============================================================
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                  # sandbox | development | production

# ============================================================
# SHOPIFY
# ============================================================
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# ============================================================
# PAYPAL
# ============================================================
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox                 # sandbox | production

# ============================================================
# LLM — Product-provided keys (users pick model, not key)
# ============================================================
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o
OPENAI_API_KEY=                    # sk-...
ANTHROPIC_API_KEY=                 # sk-ant-...

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=                   # Random string: openssl rand -base64 32

# ============================================================
# LEMONSQUEEZY (reserved — do NOT build yet)
# ============================================================
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
