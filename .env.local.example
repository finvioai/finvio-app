# ============================================================
# SUPABASE
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # Server-side only — NEVER expose to frontend

# ============================================================
# ENCRYPTION
# ============================================================
ENCRYPTION_KEY=                    # 64-char hex string (32 bytes)
                                   # Generate with: openssl rand -hex 32

# ============================================================
# STRIPE
# ============================================================
STRIPE_SECRET_KEY=                 # sk_test_... for dev, sk_live_... for prod
STRIPE_WEBHOOK_SECRET=             # whsec_... from Stripe dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============================================================
# PLAID
# ============================================================
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                  # sandbox | development | production

# ============================================================
# SHOPIFY
# ============================================================
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# ============================================================
# PAYPAL
# ============================================================
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox                 # sandbox | production

# ============================================================
# QUICKBOOKS
# Get credentials at https://developer.intuit.com
# Register QB_REDIRECT_URI as an allowed Redirect URI in the Intuit app settings.
# Change only this variable when switching environments — never hardcode URLs in code.
# ============================================================
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_ENVIRONMENT=sandbox             # sandbox | production
QB_REDIRECT_URI=https://finvio-app.vercel.app/api/connections/quickbooks/callback
# Production: QB_REDIRECT_URI=https://finvio-app.vercel.app/api/connections/quickbooks/callback
# Local: QB_REDIRECT_URI=http://localhost:3004/api/connections/quickbooks/callback

# ============================================================
# LLM — Product-provided keys (users pick model, not key)
# ============================================================
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o
OPENAI_API_KEY=                    # sk-...
ANTHROPIC_API_KEY=                 # sk-ant-...

# ============================================================
# VOICE (optional — only needed for Whisper server fallback)
# ============================================================
VOICE_DAILY_QUOTA_SECONDS=300      # 5 min per user per day on server Whisper
VOICE_MONTHLY_QUOTA_SECONDS=3600   # 1 hr per user per month on server Whisper

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=https://finvio-app.vercel.app
CRON_SECRET=                       # Random string: openssl rand -hex 32

# ============================================================
# LEMONSQUEEZY (reserved — do NOT build yet)
# ============================================================
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
