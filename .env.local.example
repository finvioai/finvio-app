# ============================================================
# SUPABASE
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # Server-side only — NEVER expose to frontend

# ============================================================
# ENCRYPTION
# ============================================================
ENCRYPTION_KEY=                    # 64-char hex string (32 bytes)
                                   # Generate with: openssl rand -hex 32

# ============================================================
# STRIPE (Stripe Connect OAuth)
# 1. dashboard.stripe.com/settings/connect → enable OAuth
# 2. Add STRIPE_REDIRECT_URI under "Redirects" in Connect settings
# 3. Copy the "client_id" (ca_...) as STRIPE_CLIENT_ID
# 4. STRIPE_SECRET_KEY is your platform's secret key (used for token exchange + webhooks)
# ============================================================
STRIPE_CLIENT_ID=ca_               # ca_... from Stripe Connect settings
STRIPE_SECRET_KEY=                 # sk_test_... for dev, sk_live_... for prod (platform key)
STRIPE_WEBHOOK_SECRET=             # whsec_... from Stripe dashboard
STRIPE_REDIRECT_URI=https://finvio-app.vercel.app/api/connections/stripe/callback
# Local: STRIPE_REDIRECT_URI=http://localhost:3004/api/connections/stripe/callback
# Must exactly match the redirect URI added in Stripe Connect settings

# ============================================================
# PLAID
# ============================================================
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                  # sandbox | development | production

# ============================================================
# SHOPIFY (Shopify Partner OAuth App)
# 1. partners.shopify.com → Apps → Create app → Public app
# 2. App setup → Allowed redirection URL(s): add SHOPIFY_REDIRECT_URI
# 3. API credentials: copy API key (client ID) and API secret key
# ============================================================
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URI=https://finvio-app.vercel.app/api/connections/shopify/callback
# Local: SHOPIFY_REDIRECT_URI=http://localhost:3000/api/connections/shopify/callback
# Must exactly match the URL added in Shopify Partner app → App setup → Allowed redirection URL(s)

# ============================================================
# PAYPAL
# ============================================================
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox                 # sandbox | production

# ============================================================
# QUICKBOOKS
# Get credentials at https://developer.intuit.com
# Register QB_REDIRECT_URI as an allowed Redirect URI in the Intuit app settings.
# Change only this variable when switching environments — never hardcode URLs in code.
# ============================================================
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_ENVIRONMENT=sandbox             # sandbox | production
QB_REDIRECT_URI=https://finvio-app.vercel.app/api/connections/quickbooks/callback
# Production: QB_REDIRECT_URI=https://finvio-app.vercel.app/api/connections/quickbooks/callback
# Local: QB_REDIRECT_URI=http://localhost:3004/api/connections/quickbooks/callback

# ============================================================
# GMAIL (Google OAuth 2.0 — read-only email access)
# 1. console.cloud.google.com → New project → Enable "Gmail API"
# 2. APIs & Services → Credentials → Create OAuth 2.0 Client ID (Web application)
# 3. Add GMAIL_REDIRECT_URI to "Authorized redirect URIs"
# ============================================================
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://your-app.vercel.app/api/connections/gmail/callback
# Local: GMAIL_REDIRECT_URI=http://localhost:3004/api/connections/gmail/callback
# Production: GMAIL_REDIRECT_URI=https://your-app.vercel.app/api/connections/gmail/callback

# ============================================================
# OUTLOOK (Microsoft OAuth 2.0 — read-only email access)
# 1. portal.azure.com → Azure Active Directory → App registrations → New registration
# 2. Platform: Web → add OUTLOOK_REDIRECT_URI as a Redirect URI
# 3. API permissions → Add → Microsoft Graph → Delegated → Mail.Read
# 4. Certificates & secrets → New client secret → copy value
# ============================================================
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=https://your-app.vercel.app/api/connections/outlook/callback
# Local: OUTLOOK_REDIRECT_URI=http://localhost:3004/api/connections/outlook/callback

# ============================================================
# LLM — Product-provided keys (users pick model, not key)
# ============================================================
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o
OPENAI_API_KEY=                    # sk-...
ANTHROPIC_API_KEY=                 # sk-ant-...

# ============================================================
# VOICE (optional — only needed for Whisper server fallback)
# ============================================================
VOICE_DAILY_QUOTA_SECONDS=300      # 5 min per user per day on server Whisper
VOICE_MONTHLY_QUOTA_SECONDS=3600   # 1 hr per user per month on server Whisper

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=https://finvio-app.vercel.app
#NEXT_PUBLIC_APP_URL=http://localhost:3000
#NEXT_PUBLIC_APP_URL=https://finvio.ai
CRON_SECRET=                       # Random string: openssl rand -hex 32

# ============================================================
# LEMONSQUEEZY (reserved — do NOT build yet)
# ============================================================
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
